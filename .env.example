# Supply generated secrets through an environment manager; no defaults.
NODE_ENV=development
PORT=3000
MONGODB_URI=
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_TLS=false
MONGODB_TLS_CA_FILE=
JWT_SECRET=
# No refresh-token flow: JWT_REFRESH_SECRET is not used.
FRONTEND_URL=http://localhost:4200,http://127.0.0.1:4200
HTTPS_ENABLED=false
BUSINESS_UTC_OFFSET=-03:00
# Fixed windows of 60 seconds, per process. Shared deployments require a shared limiter.
RATE_LIMIT_GENERAL=120
RATE_LIMIT_ADMIN=60
RATE_LIMIT_LOGIN=5
RATE_LIMIT_LOGOUT=10
RATE_LIMIT_ORDER_CREATE=30
RATE_LIMIT_PAYMENT=15
# No automatic seeds. Provision first ADMIN explicitly with bcrypt cost 12.
# QA only: mongodb://127.0.0.1:27017/salgados_financeiro_test

TENANCY_V2_ENABLED=false
TENANCY_NEW_INSTALLATION=false
CPF_ENCRYPTION_KEY=
CPF_HASH_KEY=
